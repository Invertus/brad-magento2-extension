<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Default implementation of the BradSearch price-calculation contract.
        Clients with bespoke pricing logic should override this <preference>
        in their own bridge module (e.g. Magenmagic_BradSearchPrice for Verkter).
    -->
    <preference for="BradSearch\SearchGraphQl\Api\PriceCalculatorInterface"
                type="BradSearch\SearchGraphQl\Model\Price\VanillaMagentoPriceCalculator"/>

    <!-- Plugin to intercept products search query and return BradSearch results -->
    <type name="Magento\CatalogGraphQl\Model\Resolver\Products">
        <plugin name="bradsearch_search_interceptor"
                type="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Products"/>
    </type>

    <!-- Also intercept ElasticSuite resolver if used -->
    <type name="Smile\ElasticsuiteCatalogGraphQl\Model\Resolver\Products">
        <plugin name="bradsearch_search_interceptor_elasticsuite"
                type="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Products"/>
    </type>

    <!-- Plugin to intercept aggregations and return mock data when BradSearch enabled -->
    <type name="Magento\CatalogGraphQl\Model\Resolver\Aggregations">
        <plugin name="bradsearch_aggregations_interceptor"
                type="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Aggregations"/>
    </type>

    <!-- Also intercept ElasticSuite aggregations resolver -->
    <type name="Smile\ElasticsuiteCatalogGraphQl\Model\Resolver\Aggregations">
        <plugin name="bradsearch_aggregations_interceptor_elasticsuite"
                type="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Aggregations"/>
    </type>

    <!-- BradSearch unified logger configuration -->

    <!-- DebugLogger decorator: suppresses debug/info unless admin setting is enabled -->
    <type name="BradSearch\SearchGraphQl\Model\Logger\DebugLogger">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\VirtualLogger</argument>
        </arguments>
    </type>

    <!-- Sync components -->
    <type name="BradSearch\SearchGraphQl\Cron\SyncChangedProducts">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\Sync\ChangelogReader">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\Sync\FetchRecorder">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\Sync\WebhookNotifier">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <!--
        Attributes the sync reads whatever their searchable/filterable flags: BradProducts
        COLLECTION_ATTRIBUTES, ProductFeatures ProductDataLoader WHITELIST_ATTRIBUTES, status and
        visibility. A price calculator that reads other attributes adds an attributeProviders item.
    -->
    <type name="BradSearch\SearchGraphQl\Model\Sync\ChangeFilter">
        <arguments>
            <argument name="attributeCodes" xsi:type="array">
                <item name="name" xsi:type="string">name</item>
                <item name="sku" xsi:type="string">sku</item>
                <item name="url_key" xsi:type="string">url_key</item>
                <item name="image" xsi:type="string">image</item>
                <item name="short_description" xsi:type="string">short_description</item>
                <item name="description" xsi:type="string">description</item>
                <item name="price" xsi:type="string">price</item>
                <item name="price_type" xsi:type="string">price_type</item>
                <item name="special_price" xsi:type="string">special_price</item>
                <item name="special_from_date" xsi:type="string">special_from_date</item>
                <item name="special_to_date" xsi:type="string">special_to_date</item>
                <item name="tax_class_id" xsi:type="string">tax_class_id</item>
                <item name="mm_popularity" xsi:type="string">mm_popularity</item>
                <item name="manufacturer" xsi:type="string">manufacturer</item>
                <item name="mpn" xsi:type="string">mpn</item>
                <item name="barcode" xsi:type="string">barcode</item>
                <item name="middle_of_product_name" xsi:type="string">middle_of_product_name</item>
                <item name="beginning_of_product_nam" xsi:type="string">beginning_of_product_nam</item>
                <item name="amazon_asin" xsi:type="string">amazon_asin</item>
                <item name="status" xsi:type="string">status</item>
                <item name="visibility" xsi:type="string">visibility</item>
            </argument>
        </arguments>
    </type>

    <!-- API and plugin components -->
    <type name="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Products">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <!-- API Key Validator for private endpoint authentication -->
    <type name="BradSearch\SearchGraphQl\Model\Api\Auth\ApiKeyValidator">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <!-- BradProducts resolver -->
    <type name="BradSearch\SearchGraphQl\Model\Resolver\BradProducts">
        <arguments>
            <argument name="apiKeyValidator" xsi:type="object">BradSearch\SearchGraphQl\Model\Api\Auth\ApiKeyValidator</argument>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Plugin\CatalogGraphQl\Model\Resolver\Aggregations">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\Api\Client">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\MockData\ProductsProvider">
        <arguments>
            <argument name="apiClient" xsi:type="object">BradSearch\SearchGraphQl\Model\Api\Client</argument>
            <argument name="responseMapper" xsi:type="object">BradSearch\SearchGraphQl\Model\Api\ResponseMapper</argument>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\Api\ResponseMapper">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <type name="BradSearch\SearchGraphQl\Model\MockData\AggregationsProvider">
        <arguments>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <!-- Virtual logger that writes to bradsearch.log (unified log file).
         Built on Monolog\Logger, not Magento\Framework\Logger\Monolog: a virtualType of the
         latter inherits its handlers array (system, debug, syslog) and Magento merges array
         arguments by item name, so bradsearch INFO/ERROR would still reach system.log. -->
    <virtualType name="BradSearch\SearchGraphQl\Model\Logger\VirtualLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">bradsearch</argument>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\Handler\DebugHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BradSearch\SearchGraphQl\Model\Logger\Handler\DebugHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/bradsearch.log</argument>
        </arguments>
    </virtualType>

    <!-- UpdateConfig resolver for remote configuration -->
    <type name="BradSearch\SearchGraphQl\Model\Resolver\UpdateConfig">
        <arguments>
            <argument name="apiKeyValidator" xsi:type="object">BradSearch\SearchGraphQl\Model\Api\Auth\ApiKeyValidator</argument>
            <argument name="logger" xsi:type="object">BradSearch\SearchGraphQl\Model\Logger\DebugLogger</argument>
        </arguments>
    </type>

    <!-- Add mm_popularity attribute to GraphQL product collection -->
    <type name="Magento\CatalogGraphQl\Model\Resolver\Products\DataProvider\Product\CompositeCollectionProcessor">
        <arguments>
            <argument name="collectionProcessors" xsi:type="array">
                <item name="bradsearch_popularity" xsi:type="object">BradSearch\SearchGraphQl\Model\Resolver\Products\DataProvider\Product\CollectionProcessor\PopularityAttributeProcessor</item>
            </argument>
        </arguments>
    </type>

</config>
