# Copyright © BradSearch. All rights reserved.

input BradProductFilterInput {
    entity_id: FilterEqualTypeInput @doc(description: "Filter products by entity ID")
}

interface ProductInterface {
    sort_popularity: String @doc(description: "Popularity composite string for alphabetical sorting (e.g., 'I123INUL'). Lower values = higher priority.") @resolver(class: "BradSearch\\SearchGraphQl\\Model\\Resolver\\SortPopularityResolver")
    sort_popularity_sales: Int @doc(description: "Sales component extracted from sort_popularity (3-digit reversed sales rank).") @resolver(class: "BradSearch\\SearchGraphQl\\Model\\Resolver\\SortPopularitySalesResolver")
    calculated_price: BradSearchCalculatedPriceRange @doc(description: "Price computed via BradSearch\\SearchGraphQl\\Api\\PriceCalculatorInterface. Populated by the bradProducts query; null elsewhere. Use this field (not price_range) for BradSearch sync.")
}

type Products {
    bradsearch_search: BradSearchSearchTracking @doc(description: "BradSearch data for the search results page's analytics events (view-search, search-product-click). Set on BradSearch keyword searches (the ProductSearch operation); null otherwise.")
}

type BradSearchSearchTracking {
    correlation_id: String @doc(description: "The BradSearch request's correlation id. Send it with the page's analytics events as X-Request-Correlation-ID.")
    ai_search: BradSearchAiSearch @doc(description: "Set when BradSearch AI search answered the query; null for a normal search.")
    ai_matches: [BradSearchAiMatch] @doc(description: "AI search only: how each shown product matched the query. Empty for a normal search.")
}

type BradSearchAiSearch {
    used: Boolean! @doc(description: "Always true when ai_search is set.")
    match: String! @doc(description: "exact: at least one shown product matches exactly; close: products are shown but none matches exactly; none: nothing to show.")
}

type BradSearchAiMatch {
    product_id: Int! @doc(description: "Product entity ID")
    ai_match: String! @doc(description: "exact or close")
}

type BradSearchCalculatedPriceRange {
    minimum_price: BradSearchCalculatedPrice! @doc(description: "The lowest effective price for the product.")
    maximum_price: BradSearchCalculatedPrice @doc(description: "The highest effective price for the product.")
}

type BradSearchCalculatedPrice {
    regular_price: Money @doc(description: "Pre-discount price.")
    final_price: Money @doc(description: "Effective price including tax.")
    final_price_excl_tax: Money @doc(description: "Effective price excluding tax.")
}

type Query {
    bradProducts(
        filter: BradProductFilterInput
        pageSize: Int = 300
        currentPage: Int = 1
    ): BradProductsOutput @resolver(class: "BradSearch\\SearchGraphQl\\Model\\Resolver\\BradProducts") @doc(description: "Direct MySQL product listing for BradSearch sync, ordered by entity_id ascending so offset pages are stable. Requires X-BradSearch-Api-Key header. The module applies no stock filter of its own; total_count is read after the page loads, so it matches whatever collection plugins let through.")
}

type BradProductsOutput {
    total_count: Int @doc(description: "Total number of matching products, counted after collection plugins have applied, so it matches the items the pages deliver")
    items: [ProductInterface] @doc(description: "Product items, ordered by entity_id ascending")
    skipped_count: Int @doc(description: "Products on this page that could not be built and were left out of items. They are still part of total_count.")
    page_info: SearchResultPageInfo @doc(description: "Pagination info")
}

input BradConfigInput {
    path: String! @doc(description: "Config path (e.g. bradsearch_search/general/enabled)")
    value: String @doc(description: "Full replacement value. Mutually exclusive with json_merge.")
    json_merge: String @doc(description: "JSON to deep-merge into existing value. Mutually exclusive with value.")
}

type BradConfigResult {
    path: String! @doc(description: "The config path that was processed")
    success: Boolean! @doc(description: "Whether the update succeeded")
    message: String @doc(description: "Error message on failure, null on success")
}

type Mutation {
    bradUpdateConfig(
        items: [BradConfigInput!]!
    ): [BradConfigResult!]! @resolver(class: "BradSearch\\SearchGraphQl\\Model\\Resolver\\UpdateConfig") @doc(description: "Update BradSearch configuration remotely. Requires X-BradSearch-Api-Key header. Only whitelisted BradSearch config paths are allowed.")
}
